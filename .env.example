# ---- Supabase ----
# Local development: `npx supabase start` prints these values.
# Production: Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=info@letsbuildhome.co.zw
NEXT_PUBLIC_WHATSAPP_NUMBER=263770000000

# ---- Paynow (paynow.co.zw) ----
# Leave empty to run in SIMULATED TEST MODE (built-in fake checkout,
# clearly labelled; no real money). Set the merchant's integration
# credentials to use real Paynow (use their test keys first).
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Where Paynow posts payment results (must be publicly reachable in prod):
PAYNOW_RESULT_URL=http://localhost:3000/api/paynow/result

# ---- Email (optional; console fallback when empty) ----
RESEND_API_KEY=
EMAIL_FROM="LBH <noreply@letsbuildhome.co.zw>"

# ---- Bot protection (optional; honeypot-only when empty) ----
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Simulated checkout (TEST ONLY). Must be false/unset in production.
PAYMENTS_TEST_MODE=true
