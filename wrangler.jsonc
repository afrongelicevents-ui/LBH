{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lbh",
  "main": "worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Chat assistant: Workers AI (free daily allowance; model can be changed with the AI_MODEL variable)
  "ai": { "binding": "AI" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "lbh" }],
  // Photo re-encoding (replaces sharp): Cloudflare Images
  "images": { "binding": "IMAGES" },
  // Daily: Build Account renewal reminders + receipt clean-up (was Vercel Cron)
  "triggers": { "crons": ["17 7 * * *"] },
  "observability": { "enabled": true }
  // On the Workers Paid plan, add: "limits": { "cpu_ms": 60000 }
  // (lets slow pages such as PDFs and photo uploads use more CPU time)
}
